{
    "name": "mlbrgn/laravel-form-components",
    "description": "Blade components to rapidly build forms with Bootstrap 5.",
    "keywords": [
        "Mlbrgn",
        "bootstrap5",
        "bootstrap-5",
        "laravel",
        "form",
        "forms",
        "form-builder",
        "form-components",
        "laravel-form-builder",
        "laravel-form-components"
    ],
    "homepage": "https://github.com/mlbrgn/laravel-form-components",
    "license": "MIT",
    "type": "library",
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/homiedopie/pest-plugin-browser"
        }
    ],
    "authors": [
        {
            "name": "Nick D.",
            "email": "info@mlbrgn.nl",
            "role": "Developer"
        },
        {
            "name": "Evertjan G.",
            "email": "info@mlbrgn.nl",
            "role": "Developer"
        },
        {
            "name": "Pascal Baljet",
            "email": "pascal@protone.media",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.1 || ^8.2 || ^8.3 || ^8.4",
        "barryvdh/laravel-ide-helper": "^3.0.0",
        "illuminate/support": "^9 || ^10 || ^11 || ^12 || ^13",
        "symfony/http-foundation": "^6.0 || ^7.0 || ^8.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0.0",
        "laravel/pint": "^1.16",
        "mockery/mockery": "^1.4.4",
        "nesbot/carbon": "^3.0.0",
        "orchestra/testbench": "^10.0.0",
        "pestphp/pest": "^4.0.0",
        "pestphp/pest-plugin-browser": "dev-fix/multipart-form-parser",
        "pestphp/pest-plugin-drift": "^4.0.0",
        "pestphp/pest-plugin-type-coverage": "^4.0.0",
        "spatie/laravel-translatable": "^6.0.0",
        "symfony/dom-crawler": "^7.0.0"
    },
    "autoload": {
        "psr-4": {
            "Mlbrgn\\LaravelFormComponents\\": "src"
        },
        "files": [
            "Helpers/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Mlbrgn\\LaravelFormComponents\\Tests\\": "tests"
        }
    },
    "scripts": {
        "analyse": "vendor/bin/phpstan analyse",
        "test:validate-composer": "composer validate --strict",
        "test:security-composer": "composer audit",
        "test:security-npm": "npm audit --audit-level=moderate",
        "test:lint": "vendor/bin/pint --test",
        "test:types": "vendor/bin/pest --type-coverage --min=80",
        "test:larastan": "vendor/bin/phpstan analyse || true",
        "test:pest": "vendor/bin/pest --exclude-group browser",
        "test-ci-checks": [
            "@test:validate-composer",
            "@test:security-composer",
            "@test:security-npm",
            "@test:lint",
            "@test:types",
            "@test:larastan"
        ],
        "test-ci-tests": [
            "@test:pest"
        ],
        "test-ci": [
            "@test-ci-checks",
            "@test-ci-tests"
        ],
        "test": "vendor/bin/pest --exclude-group browser",
        "test-browser": [
            "Composer\\Config::disableProcessTimeout",
            "XDEBUG_MODE=off vendor/bin/pest --group browser"
        ],
        "test-browser-headed": [
            "Composer\\Config::disableProcessTimeout",
            "XDEBUG_MODE=off PEST_BROWSER_HEADED=true vendor/bin/pest --group browser"
        ],
        "test-browser-full": [
            "Composer\\Config::disableProcessTimeout",
            "XDEBUG_MODE=off PEST_BROWSER_FULL=true vendor/bin/pest --group browser"
        ],
        "test-browser-full-headed": [
            "Composer\\Config::disableProcessTimeout",
            "XDEBUG_MODE=off PEST_BROWSER_FULL=true PEST_BROWSER_HEADED=true vendor/bin/pest --group browser"
        ],
        "coverage": "XDEBUG_MODE=coverage ./vendor/bin/pest --coverage"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "extra": {
        "laravel": {
            "providers": [
                "Mlbrgn\\LaravelFormComponents\\Providers\\FormComponentsServiceProvider"
            ]
        }
    }
}
